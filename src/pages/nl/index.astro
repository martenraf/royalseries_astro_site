---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BuyModal from '../../components/BuyModal.astro';

const TITLE = "Een Koninklijk Leven - Hoe eenheid met Christus de rivier van God laat stromen";
const DESCRIPTION = "Ontdek hoe je stopt met leven naar God toe en leert leven vanuit je eenheid met Christus. Een Koninklijk Leven laat zien hoe Gods aanwezigheid, vrede en kracht door de Heilige Geest steeds meer je dagelijkse leven kunnen vullen.";
const TAGLINE = "Leef vanuit Christus als Bron. Laat de Rivier van God stromen.";
---

<BaseLayout title={TITLE} description={DESCRIPTION} lang="nl">

  <!-- HERO -->
  <section id="hero" class="relative min-h-[88vh] bg-gradient-to-br from-background via-background to-accent/5 pt-28 pb-16 px-4 sm:px-6 lg:px-8 overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-accent/10 rounded-full blur-3xl -z-10 opacity-50"></div>

    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center min-h-[calc(88vh-176px)]">
        <div class="space-y-7">
          <div class="space-y-3">
            <p class="text-accent font-display font-semibold text-lg tracking-wide uppercase">Nieuw boek</p>
            <h1 class="text-primary leading-tight">Een Koninklijk Leven</h1>
            <p class="text-xl sm:text-2xl md:text-3xl text-foreground font-display font-light leading-snug">
              Hoe eenheid met Christus de Rivier van God laat stromen
            </p>
          </div>

          <div class="max-w-xl space-y-4 font-body">
            <p class="text-xl font-semibold text-primary leading-relaxed">
              Verlang je naar een leven in Gods aanwezigheid?
            </p>
            <p class="text-lg text-foreground/80 leading-relaxed">
              Veel christenen leven <span class="font-semibold text-primary">naar God toe</span>, terwijl het Evangelie ons uitnodigt om <span class="font-semibold text-primary">vanuit Hem</span> te leven.
            </p>
            <blockquote class="border-l-4 border-accent bg-card/80 px-5 py-4 rounded-r-md shadow-soft">
              <p class="font-display text-lg text-primary italic leading-relaxed">
                “Kom naar Mij toe… en Ik zal je rust geven.”
              </p>
              <cite class="mt-2 block text-sm font-semibold not-italic text-foreground/60">Mattheüs 11:28</cite>
            </blockquote>
          </div>

          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <button type="button" onclick="window.openBuyModal?.()"
              class="inline-flex items-center justify-center px-8 py-4 bg-accent text-foreground font-display font-semibold text-lg hover:opacity-90 hover:shadow-soft transition-all duration-300 rounded-md">
              Bekijk op Amazon
            </button>

            <a href="https://chatgpt.com/g/g-69904d77fdc8819199d138dc318277dc-royal-life-companion"
              target="_blank" rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary text-primary hover:bg-primary/5 font-display font-semibold text-lg transition-all duration-300 rounded-md">
              Open de Royal Life Companion
            </a>
          </div>
        </div>

        <div class="flex justify-center items-center">
          <div class="relative">
            <div class="absolute inset-0 bg-gradient-to-br from-accent/20 to-primary/20 rounded-lg blur-2xl"></div>
            <img src="/img/book.jpg" alt="A Royal Life Book Cover"
              class="relative w-full max-w-sm h-auto rounded-lg shadow-2xl border-4 border-primary/20" />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="py-24 md:py-28 px-4 sm:px-6 lg:px-8 bg-card">
    <div class="max-w-6xl mx-auto space-y-12">
      <div class="text-center space-y-4">
        <h2 class="text-primary">Over het boek</h2>
        <div class="w-24 h-1 bg-accent mx-auto rounded-full"></div>
      </div>

      <div class="max-w-3xl mx-auto text-center text-foreground font-body">
        <p class="text-lg leading-8">
          Verlang je naar een leven vanuit je eenheid met Christus en je identiteit in Hem? Christus heeft je al dichtbij gebracht. Een Koninklijk Leven helpt je ontdekken hoe je vanuit die werkelijkheid kunt leven.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="h-full border border-primary/15 border-t-4 border-t-accent bg-background p-7 rounded-md shadow-soft">
          <h3 class="text-xl font-display font-semibold text-primary">Eenheid met Christus</h3>
          <p class="mt-2 font-display font-semibold text-accent">Jouw levensbron</p>
          <p class="mt-4 text-foreground/75 font-body leading-relaxed">
            De Bron waaruit je leeft en waarin je nieuwe identiteit tot leven komt.
          </p>
        </article>
        <article class="h-full border border-primary/15 border-t-4 border-t-accent bg-background p-7 rounded-md shadow-soft">
          <h3 class="text-xl font-display font-semibold text-primary">De Rivier van God</h3>
          <p class="mt-2 font-display font-semibold text-accent">Jouw levensstroom</p>
          <p class="mt-4 text-foreground/75 font-body leading-relaxed">
            De voortdurende stroom van Gods aanwezigheid, vrede en kracht door de Heilige Geest.
          </p>
        </article>
        <article class="h-full border border-primary/15 border-t-4 border-t-accent bg-background p-7 rounded-md shadow-soft">
          <h3 class="text-xl font-display font-semibold text-primary">De Rivierbedding</h3>
          <p class="mt-2 font-display font-semibold text-accent">Jouw levensorde</p>
          <p class="mt-4 text-foreground/75 font-body leading-relaxed">
            De Ordo Vitae laat zien hoe jouw leven de bedding vormt waarin de Rivier van God met helderheid, richting en kracht kan stromen.
          </p>
        </article>
      </div>

      <p class="max-w-3xl mx-auto text-center text-lg text-foreground/80 font-body leading-relaxed">
        Verlang je ernaar te leven in de hemelse rust van Jezus’ volbrachte werk? Dit boek brengt je terug naar de Bron, om vanuit genade te leven en uit te delen van het leven dat je ontvangen hebt.
      </p>
      </div>
  </section>

  <!-- AUTHOR -->
  <section id="author" class="py-24 md:py-28 px-4 sm:px-6 lg:px-8 bg-background">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-primary">Over de auteur</h2>
        <div class="w-24 h-1 bg-accent mx-auto rounded-full mt-4"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div class="flex justify-center md:order-2">
          <img src="/img/author.jpg" alt="Author Portrait"
            class="w-64 h-64 rounded-full shadow-2xl border-4 border-primary/20 object-cover" />
        </div>

        <div class="space-y-5 md:order-1">
          <h3 class="text-2xl md:text-3xl font-display font-semibold text-primary">Marten Busstra</h3>

          <p class="text-lg text-foreground/80 font-body leading-relaxed">
            Marten Busstra is kerkstrateeg, leraar en schrijver. Hij is 33 jaar getrouwd met Annelies en heeft twee kinderen en één kleinkind.
          </p>
          <p class="text-lg text-foreground/80 font-body leading-relaxed">
            Hij diende ruim 25 jaar als oudste en voorganger in een Foursquare-gemeente in Nederland, gedreven door een passie voor Gods Koninkrijk.
          </p>
          <p class="text-lg text-foreground/80 font-body leading-relaxed">
            In de afgelopen jaren richt Marten zich op onderwijs, training en schrijven over discipelschap en de kerk.
          </p>
          <p class="text-lg text-foreground/80 font-body leading-relaxed">
            Zijn eerste boek, <em>Een Koninklijk Leven</em>, gaat in op eenheid met Christus als het fundament van discipelschap en authentiek christelijk leven.
          </p>
        </div>
      </div>
    </div>
  </section>

<section class="py-24 md:py-28 px-4 sm:px-6 lg:px-8 bg-card">
  <div class="max-w-3xl mx-auto text-center space-y-7">

   <h3 class="text-2xl md:text-3xl font-display font-semibold text-primary">
  Visie van de Royal Series
</h3>

    <p class="text-lg text-foreground/75 font-body leading-relaxed">
      De Royal Series wil discipelschap en kerk-zijn opnieuw verankeren in Christus als Bron. Veel christelijke modellen beginnen bij wat mensen moeten doen; de Royal Series begint bij wat God in Christus heeft gedaan.
    </p>

    <p class="border-l-4 border-accent bg-background px-6 py-5 text-xl md:text-2xl font-display font-semibold text-primary leading-relaxed text-left rounded-r-md">
      Een Koninklijk Leven laat zien hoe discipelschap begint bij Christus als Bron en de Rivier van de Geest door ons heen stroomt.
    </p>

    <p class="text-lg text-foreground/75 font-body leading-relaxed">
      Vanuit die basis worden discipelen gevormd als kanalen van Gods leven en worden kerken plaatsen waar het Koninkrijk van God zichtbaar wordt.
    </p>

  </div>
</section>

<section id="companion" class="py-24 md:py-28 px-4 sm:px-6 lg:px-8 bg-gradient-to-br from-primary to-primary/90 text-white">
  <div class="absolute top-0 right-0 w-96 h-96 bg-accent/10 rounded-full blur-3xl -z-10 opacity-30"></div>

  <div class="max-w-5xl mx-auto">
    <div class="text-center space-y-4 mb-12">
      <h2 class="text-white">De Royal Life Companion</h2>
      <div class="w-24 h-1 bg-accent mx-auto rounded-full"></div>
    </div>

    <div class="space-y-8">
      <p class="text-lg md:text-xl text-center text-white/85 font-body leading-relaxed max-w-2xl mx-auto">
        De Royal Life Companion helpt je om de boodschap van <em>Een Koninklijk Leven</em> persoonlijk toe te passen.
      </p>

      <p class="text-center text-2xl md:text-3xl font-display font-semibold text-accent">
        Vraag. Onderzoek. Pas toe.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <div class="bg-white/10 backdrop-blur rounded-lg p-6 shadow-soft hover:bg-white/15 transition-all duration-300">
          <div class="text-3xl text-accent mb-4">💬</div>
          <h3 class="font-display font-semibold text-lg mb-3">Interactief leren</h3>
          <p class="text-sm text-white/80">
            Ga in gesprek over het koninklijke leven dat je ontvangen hebt.
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur rounded-lg p-6 shadow-soft hover:bg-white/15 transition-all duration-300">
          <div class="text-3xl text-accent mb-4">🎯</div>
          <h3 class="font-display font-semibold text-lg mb-3">Persoonlijke begeleiding</h3>
          <p class="text-sm text-white/80">
            Ontvang gerichte vragen die je helpen vanuit Christus te leven.
          </p>
        </div>

        <div class="bg-white/10 backdrop-blur rounded-lg p-6 shadow-soft hover:bg-white/15 transition-all duration-300">
          <div class="text-3xl text-accent mb-4">🌊</div>
          <h3 class="font-display font-semibold text-lg mb-3">Dieper de Rivier in</h3>
          <p class="text-sm text-white/80">
            Herken de rivierbedding, de Ordo Vitae, in je dagelijkse leven.
          </p>
        </div>
      </div>

      <div class="text-center space-y-6">
        <a href="https://chatgpt.com/g/g-69904d77fdc8819199d138dc318277dc-royal-life-companion"
           target="_blank"
           rel="noopener noreferrer"
           class="inline-flex items-center justify-center px-10 py-4 bg-white text-primary font-display font-bold text-lg hover:bg-accent hover:text-foreground transition-all duration-300 rounded-md shadow-lg">
          Open De Royal Life Companion
        </a>

        <p class="text-sm text-white/70 italic">
          Vereist een gratis of betaald ChatGPT-account
        </p>
      </div>
    </div>
  </div>
</section>

  <!-- BUY -->
  <section id="get-book" class="py-16 md:py-20 px-4 sm:px-6 lg:px-8 bg-card text-center">
    <div class="max-w-2xl mx-auto">
      <h2 class="text-primary">Begin te leven vanuit de Bron</h2>
      <p class="text-lg text-foreground/80 mt-4">
        Verlang je ernaar te wandelen in de vrijheid en autoriteit van Gods Koninkrijk? <em>Een Koninklijk Leven</em> is verkrijgbaar via Amazon.
      </p>

      <button type="button" onclick="window.openBuyModal?.()"
        class="mt-7 inline-flex items-center justify-center px-10 py-4 bg-accent text-foreground font-display font-bold text-lg rounded-md shadow-lg hover:opacity-90 hover:shadow-xl transition-all duration-300">
        Koop op Amazon
      </button>
    </div>
  </section>

  <BuyModal bookKey="royalLife" pageLang="nl" />

</BaseLayout>
